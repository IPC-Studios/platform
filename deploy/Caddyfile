# Auto-HTTPS for both the API and the web SPA. Domains come from .env. Caddy
# obtains + renews Let's Encrypt certs for each and reverse_proxy sets
# X-Forwarded-For, which the app's rate limiter reads for the client IP.

# API
{$API_DOMAIN} {
	encode gzip zstd
	reverse_proxy api:8787
}

# Web SPA — static files from the shared web_dist volume, with history fallback.
{$WEB_DOMAIN} {
	root * /srv
	encode gzip zstd
	try_files {path} /index.html
	file_server
}
