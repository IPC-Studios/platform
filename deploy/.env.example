# Copy to repo-root .env (gitignored) and fill in. Consumed by docker-compose.

# --- Runtime ---
PORT=8787
ENVIRONMENT=production

# --- Caddy ---
# Public hostname for the API; Caddy issues a TLS cert for it automatically.
# (The web frontend is hosted on Cloudflare Pages, not on this box.)
API_DOMAIN=api.yourstudio.in

# --- Postgres (self-hosted, the db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=ipc
# The unprivileged login role the API connects as (SET ROLEs per request).
# Keep it alphanumeric — it is interpolated into SQL + the DATABASE_URL.
DB_AUTHENTICATOR_PASSWORD=change-me-authenticator-password

# --- Auth ---
# HS256 signing secret for app JWTs (was GoTrue). Use a long random string.
JWT_SECRET=generate-a-long-random-secret

# --- Email verification (Resend) ---
# Required in production: sign-in is refused until the user verifies their email.
# RESEND_API_KEY from resend.com; EMAIL_FROM a verified sender; APP_URL is the WEB
# app origin (where /verify lives) used to build the link.
RESEND_API_KEY=
EMAIL_FROM=IPC Studios <noreply@yourstudio.in>
APP_URL=https://app.yourstudio.in
# Testing without email set up: set ENVIRONMENT to anything but "production" and
# /auth/register returns the verification_token in its response so you can verify
# manually (POST /auth/verify or open APP_URL/verify?token=...).

# --- CORS ---
# Comma-separated web origins allowed to call the API (no trailing slash).
# Must include the Cloudflare Pages URL (e.g. https://ipc-studios.pages.dev and/
# or your custom app domain).
ALLOWED_ORIGINS=https://app.yourstudio.in

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cron shared secret (x-cron-secret header on /cron/reminders) ---
CRON_SECRET=generate-a-long-random-string

# --- Meta lead ads ---
# The verify token you type into Meta's webhook subscription form; the API
# refuses the GET handshake unless it matches.
META_VERIFY_TOKEN=

# --- Observability ---
# Header carrying the real client address, set by the proxy in front of the
# API. Caddy/nginx: X-Forwarded-For (default). Behind Cloudflare: CF-Connecting-IP.
CLIENT_IP_HEADER=X-Forwarded-For
# Sentry-compatible DSN. Empty = errors are written to the structured log only.
SENTRY_DSN=
# debug | info | warn | error
LOG_LEVEL=info
# Release identifier shown by /health and attached to error reports.
APP_VERSION=

# --- Meta lead ads: real lead fetch + webhook signature ---
# App secret verifies X-Hub-Signature-256 on every Meta post; the page token
# fetches the lead's fields by leadgen_id. Both empty = generic JSON webhook only.
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# --- WhatsApp Cloud API (optional) ---
# With both set, "send template" delivers the message from the API instead of
# opening wa.me on the user's phone.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Refresh-token cookie mode (optional, recommended in production) ---
# AUTH_COOKIE=1 keeps the 30-day refresh token in an HttpOnly cookie on the API
# origin, out of reach of any script. Use SAMESITE=none (with HTTPS) when the
# app and the API are on different sites; DOMAIN scopes the cookie to a parent.
AUTH_COOKIE=
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
