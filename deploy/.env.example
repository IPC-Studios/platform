# Copy to repo-root .env (gitignored) and fill in. Consumed by docker-compose.
# These are the exact keys the API reads from c.env (see services/api/src/context.ts).

# --- Runtime ---
PORT=8787
ENVIRONMENT=production

# --- Caddy ---
# Public hostname for the API; Caddy issues a TLS cert for it automatically.
API_DOMAIN=api.yourstudio.in

# --- Supabase (external, unchanged from the Workers setup) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- CORS ---
# Comma-separated web origins allowed to call the API (no trailing slash).
# Must include wherever the frontend is served from.
ALLOWED_ORIGINS=https://app.yourstudio.in

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cron shared secret (x-cron-secret header on /cron/reminders) ---
CRON_SECRET=generate-a-long-random-string
