# Copy to repo-root .env (gitignored) and fill in. Consumed by docker-compose.

# --- Runtime ---
PORT=8787
ENVIRONMENT=production

# --- Caddy ---
# Public hostname for the API; Caddy issues a TLS cert for it automatically.
# (The web frontend is hosted on Cloudflare Pages, not on this box.)
API_DOMAIN=api.yourstudio.in

# --- Postgres (self-hosted, the db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=ipc
# The unprivileged login role the API connects as (SET ROLEs per request).
# Keep it alphanumeric — it is interpolated into SQL + the DATABASE_URL.
DB_AUTHENTICATOR_PASSWORD=change-me-authenticator-password

# --- Auth ---
# HS256 signing secret for app JWTs (was GoTrue). Use a long random string.
JWT_SECRET=generate-a-long-random-secret

# --- CORS ---
# Comma-separated web origins allowed to call the API (no trailing slash).
# Must include the Cloudflare Pages URL (e.g. https://ipc-studios.pages.dev and/
# or your custom app domain).
ALLOWED_ORIGINS=https://app.yourstudio.in

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cron shared secret (x-cron-secret header on /cron/reminders) ---
CRON_SECRET=generate-a-long-random-string
