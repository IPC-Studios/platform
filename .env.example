# ── Integrations (server-only) ──────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

RESEND_API_KEY=

# ── Jobs ────────────────────────────────────────────────────
