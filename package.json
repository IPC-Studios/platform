{
  "name": "ipc-studios",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@ipc/web' dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run --filter '@ipc/web' test:e2e",
    "db:link": "supabase link",
    "db:deploy": "supabase db push",
    "db:seed": "supabase db push --include-seed",
    "db:reset": "supabase db reset",
    "deploy:api": "echo 'API deploys via Docker Compose — see docs/vps-deploy.md'",
    "deploy:web": "bun run --filter '@ipc/web' deploy"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.0.0"
  }
}
