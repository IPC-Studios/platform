{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipc-web",
  "compatibility_date": "2025-01-01",
  // Static-assets deploy: `wrangler deploy` uploads the Vite build output.
  // single-page-application => unknown paths serve index.html (client routing).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
